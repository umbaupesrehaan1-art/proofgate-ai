# Configure the one repository root the API is permitted to inspect.
# This file is an example and is not automatically loaded; set the variable
# in the backend CMD window before starting Uvicorn.
PROOFGATE_REPOSITORY_ROOT=C:\Users\DELL\Desktop\proofgate-ai

# Frontend API root. The default /api uses the Vite development proxy.
VITE_PROOFGATE_API_URL=/api
PROOFGATE_BACKEND_URL=http://127.0.0.1:8000